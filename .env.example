# ---- Wompi (https://comercios.wompi.co → Desarrolladores) -------------------
# Llaves de sandbox empiezan por pub_test_; producción por pub_prod_.
# El entorno (sandbox o producción) se decide por el prefijo de la llave pública.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# URL pública del sitio, sin barra final. Wompi redirige aquí tras el pago y
# los correos enlazan aquí. Registra <URL>/api/wompi/events como URL de eventos
# en el panel de Wompi. En local puede quedar vacía.
NEXT_PUBLIC_SITE_URL=

# ---- Correos (Resend, https://resend.com) ------------------------------------
# Con esto la compradora recibe el PDF por email y Caro recibe cada pedido.
RESEND_API_KEY=
# Remitente verificado en Resend. Por defecto: Caro Health <hola@caro.health>
MAIL_FROM=
# A dónde llegan los avisos de pedido. Por defecto: hola@caro.health
ORDERS_NOTIFY_EMAIL=

# ---- Libro digital -----------------------------------------------------------
# Secreto para firmar los enlaces de descarga (si falta, se usa WOMPI_INTEGRITY_SECRET).
BOOK_DOWNLOAD_SECRET=
# Ruta al PDF del libro. Por defecto: ./private/libro.pdf
BOOK_PDF_PATH=
# Copia remota privada del PDF (Vercel Blob privado, S3 presignado, etc.).
# Obligatoria en hosting sin disco (Vercel): el repo es público y el PDF no se
# sube a git, así que en el servidor no existe ./private/libro.pdf.
BOOK_PDF_URL=
